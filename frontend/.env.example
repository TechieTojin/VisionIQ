# VisionIQ frontend configuration (Vite).
# Copy to frontend/.env.local and adjust. Never commit a filled-in file.
#
# NOTE: every VITE_* value is embedded in the built JavaScript and is public.
# Nothing secret may go here. The Cognito app client is intentionally a PUBLIC
# client with no secret (Terraform: generate_secret = false), which is why the
# sign-in flow uses PKCE.

# ---------------------------------------------------------------------------
# API transport
# ---------------------------------------------------------------------------
# local : FastAPI. One synchronous call does everything —
#         POST /api/images/detect returns the finished AnalysisRecord.
# cloud : API Gateway + Lambda. Analysis is asynchronous —
#         presign -> PUT to S3 -> create job -> poll until terminal.
#
# Both return the SAME response shapes for equivalent resources, so only the
# choreography differs. An unrecognised value falls back to "local".
VITE_API_MODE=local

# API origin. Empty (the default) means same-origin relative /api paths, which
# the Vite dev proxy forwards to the local backend on :8080.
# In cloud mode set this to the API Gateway invoke URL:
#   terraform output -raw api_endpoint
# VITE_API_BASE_URL=https://abc123.execute-api.us-east-1.amazonaws.com

# Cloud job polling. Defaults: 2000 ms between polls, 300000 ms (5 min) before
# giving up. Giving up does not cancel the job — it may still finish and
# appear in the scan history.
# VITE_JOB_POLL_INTERVAL_MS=2000
# VITE_JOB_POLL_TIMEOUT_MS=300000

# ---------------------------------------------------------------------------
# Authentication mode
# ---------------------------------------------------------------------------
# local   : no authentication. The backend must also run with
#           VISIONIQ_AUTH_MODE=none. Every request is the tenant "local".
#           DEVELOPMENT ONLY — a production build refuses to start in this
#           mode and shows a configuration error instead.
# cognito : Cognito hosted UI, authorization code flow with PKCE.
VITE_AUTH_MODE=local

# ---------------------------------------------------------------------------
# Cognito (required when VITE_AUTH_MODE=cognito)
# ---------------------------------------------------------------------------
# After `terraform apply`, read these from the stack outputs:
#   terraform output -raw cognito_hosted_ui_domain
#   terraform output -raw cognito_client_id
#   terraform output -raw cognito_issuer
#
# VITE_COGNITO_DOMAIN=visioniq-dev-ab12cd34.auth.us-east-1.amazoncognito.com
# VITE_COGNITO_CLIENT_ID=<app client id>
# VITE_COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/<user-pool-id>

# Space-separated. Must be a subset of Terraform's allowed_oauth_scopes.
# VITE_COGNITO_SCOPES=openid email profile

# Defaults to window.location.origin, which is what Terraform registers as the
# callback URL. Cognito requires an EXACT match, so do not append a path.
# Must be https in a production build.
# VITE_COGNITO_REDIRECT_URI=https://visioniq.example.com

# ---------------------------------------------------------------------------
# Backend pairing
# ---------------------------------------------------------------------------
# VITE_AUTH_MODE=local    <-> VISIONIQ_AUTH_MODE=none
# VITE_AUTH_MODE=cognito  <-> VISIONIQ_AUTH_MODE=apigateway (deployed)
#                             or VISIONIQ_AUTH_MODE=jwt (direct uvicorn)
# The backend's VISIONIQ_JWT_AUDIENCE must equal VITE_COGNITO_CLIENT_ID, and
# its VISIONIQ_JWT_ISSUER must equal VITE_COGNITO_ISSUER.
