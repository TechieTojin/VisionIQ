# Terraform remote state backend — partial configuration.
#
# Copy to `backend.hcl` and fill in YOUR values, then:
#     terraform init -backend-config=backend.hcl
#
# `backend.hcl` is gitignored: the bucket name is account-specific and is not
# something this repository should carry.
#
# ---------------------------------------------------------------------------
# These resources are NOT managed by this Terraform stack.
# ---------------------------------------------------------------------------
# A Terraform state backend cannot be created by the same configuration that
# stores its state there — a chicken-and-egg problem. Create them once, by
# hand, before the first `init`. They also survive `terraform destroy`, so
# they must be removed separately during teardown.
#
# Bootstrap (run once; replace the placeholders, nothing here is invented):
#
#   $BUCKET = "visioniq-tfstate-<your-account-id>"   # must be globally unique
#   $REGION = "us-east-1"
#
#   aws s3api create-bucket --bucket $BUCKET --region $REGION
#   aws s3api put-bucket-versioning --bucket $BUCKET \
#       --versioning-configuration Status=Enabled
#   aws s3api put-bucket-encryption --bucket $BUCKET \
#       --server-side-encryption-configuration \
#       '{"Rules":[{"ApplyServerSideEncryptionByDefault":{"SSEAlgorithm":"AES256"}}]}'
#   aws s3api put-public-access-block --bucket $BUCKET \
#       --public-access-block-configuration \
#       BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true
#
#   # State locking. Terraform 1.9 uses a DynamoDB table; 1.10+ can instead
#   # use S3-native locking via `use_lockfile = true`. This repo pins 1.9.8,
#   # so create the table.
#   aws dynamodb create-table --table-name visioniq-tfstate-lock \
#       --attribute-definitions AttributeName=LockID,AttributeType=S \
#       --key-schema AttributeName=LockID,KeyType=HASH \
#       --billing-mode PAY_PER_REQUEST --region $REGION
#
# Cost: a few cents a month. The state file is tiny and the lock table is
# on-demand, but both bill for storage while they exist.
#
# Versioning is not optional. It is the only way back from a corrupted or
# truncated state file.
# ---------------------------------------------------------------------------

# Globally unique S3 bucket holding the state file.
bucket = "REPLACE-WITH-YOUR-STATE-BUCKET"

# One key per environment. Never share a key between environments.
key = "visioniq/dev/terraform.tfstate"

region = "us-east-1"

# DynamoDB table used for state locking (Terraform 1.9).
dynamodb_table = "visioniq-tfstate-lock"

# `encrypt = true` is already set in versions.tf and is not repeated here.
