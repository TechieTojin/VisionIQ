# VisionIQ configuration template.
# Copy to backend/.env and adjust. NEVER commit a filled-in .env.
# All values below are the built-in defaults unless noted.

# ---- Computer vision ----
# yolo | sagemaker | null
VISIONIQ_DETECTION_PROVIDER=yolo
VISIONIQ_MODEL_ID=yolov8n.pt
VISIONIQ_CONFIDENCE=0.25
VISIONIQ_MAX_DETECTIONS=300
VISIONIQ_INFERENCE_TIMEOUT=60
VISIONIQ_DEVICE=cpu
VISIONIQ_IMAGE_SIZE=640
VISIONIQ_MAX_PIXELS=50000000
# VISIONIQ_MODEL_DIR=backend/models
# VISIONIQ_SAGEMAKER_ENDPOINT=

# ---- Persistence ----
# sqlite | dynamodb
VISIONIQ_REPOSITORY=sqlite
# VISIONIQ_SQLITE_PATH=backend/data/visioniq.db
# VISIONIQ_DYNAMODB_TABLE=

# ---- Image storage ----
# local | s3
VISIONIQ_STORAGE=local
# VISIONIQ_STORAGE_DIR=backend/data/images
# VISIONIQ_S3_BUCKET=
VISIONIQ_PRESIGN_TTL=300

# Key prefix for uploaded images: "{prefix}{owner_id}/{analysis_id}.{ext}".
# CROSS-COMPONENT CONTRACT — changing this requires changing, in lockstep:
#   - the Terraform variable `upload_prefix`
#   - the Lambda's UPLOAD_PREFIX env var (set by the api module)
#   - the worker's IAM policy, which grants s3:GetObject on "<bucket>/uploads/*"
# backend/tests/test_cloud_contracts.py asserts both sides agree.
VISIONIQ_UPLOAD_PREFIX=uploads/

# ---- AI insights ----
# rules (deterministic, free, offline) | bedrock (optional, costs money)
VISIONIQ_INSIGHTS_PROVIDER=rules
# Model id is never hardcoded in source — set it here if using Bedrock.
# VISIONIQ_BEDROCK_MODEL_ID=
VISIONIQ_BEDROCK_TIMEOUT=20
VISIONIQ_BEDROCK_MAX_TOKENS=600

# ---- Authentication ----
# none       : local dev. No auth; every request is the pseudo-tenant "local".
# apigateway : deployed behind an API Gateway JWT authorizer, which has
#              already verified the token; we read the claims it passes.
# jwt        : this process verifies tokens itself via JWKS (RS256).
VISIONIQ_AUTH_MODE=none

# Required when auth mode is "jwt" (and recommended for "apigateway", where
# the issuer is cross-checked). Terraform outputs these after apply:
#   terraform output cognito_issuer / cognito_client_id
# VISIONIQ_JWT_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/<user-pool-id>
# VISIONIQ_JWT_AUDIENCE=<cognito-app-client-id>

# Defaults to <issuer>/.well-known/jwks.json — override only if needed.
# VISIONIQ_JWKS_URL=
# Which Cognito token type to accept: "access" or "id".
VISIONIQ_JWT_TOKEN_USE=access
# Clock-skew tolerance, seconds. Keep small.
VISIONIQ_JWT_LEEWAY=30
VISIONIQ_JWKS_CACHE_TTL=3600

# NOTE: these are all public values (issuer, client id, JWKS URL). The app
# client is a PUBLIC client with no secret, so there is no credential here.

# ---- Cloud ----
AWS_REGION=us-east-1
# Reporting flag only: it sets the "execution_mode" shown in the dashboard.
# It does NOT control authentication — use VISIONIQ_AUTH_MODE for that.
VISIONIQ_CLOUD_MODE=0
# VISIONIQ_JOBS_QUEUE_URL=

# ---- Misc ----
VISIONIQ_LOG_LEVEL=INFO
VISIONIQ_RATE_LIMIT=60
# Comma-separated; defaults to localhost dev ports.
# VISIONIQ_CORS_ORIGINS=https://visioniq.example.com

# NOTE: AWS credentials are NEVER read from this file in deployed
# environments — use IAM roles (ECS task role / Lambda execution role).
